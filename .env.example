# Copy to .env.local for local development, and set the same values in Vercel.

# ---- Required: contact form (app/api/contact/route.ts) ----
# The Gmail address that both sends the mail and receives the enquiry.
EMAIL_USER=off.jatin1111@gmail.com

# A Google App Password (16 characters), NOT your Gmail account password.
# Requires 2-Step Verification on the account: myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=

# ---- Optional: site URL (lib/site.ts) ----
# Defaults to the production URL in code. Set this only to override it,
# e.g. on preview deployments so canonical/OG tags point at the preview.
# NEXT_PUBLIC_SITE_URL=https://portfolio-jatin-kumar.vercel.app
